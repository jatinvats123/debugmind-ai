{
  "name": "ecommerce-api",
  "version": "1.0.0",
  "description": "Small e-commerce style API (products, cart, checkout) for exercising a debugging agent.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "agent": "node agent/index.js",
    "agent:smoke": "node scripts/smoke-tools.js",
    "agent:offline": "node agent/index.js --restore --provider mock --cassette fixtures/three-bug-run.cassette.json",
    "agent:record": "node agent/index.js --restore --record --cassette fixtures/three-bug-run.cassette.json",
    "snapshot-bugs": "node scripts/snapshot-bugs.js",
    "restore-bugs": "node scripts/restore-bugs.js",
    "regenerate-report": "node scripts/regenerate-report.js",
    "bench": "node benchmark/bench.js",
    "bench:validate": "node benchmark/validate.js",
    "bench:report": "node benchmark/bench.js --regenerate",
    "trace:view": "node scripts/trace-view.js"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "acorn": "^8.12.0",
    "acorn-walk": "^8.3.0",
    "diff": "^7.0.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/benchmark/",
      "/.bench-workspace"
    ]
  }
}
