# Copy to .env and fill in. .env and .env.* are gitignored.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional overrides (CLI flags take precedence)
# AGENT_MODEL=gemini-3.1-flash-lite
# AGENT_EFFORT=high
# AGENT_PROVIDER=gemini

# No key is needed to replay a recorded run offline:
#   node agent/index.js --provider mock --cassette fixtures/<name>.cassette.json
